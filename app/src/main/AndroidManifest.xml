<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 设置壁纸（桌面/锁屏）必需，缺权限时 setBitmap 抛 SecurityException -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开机/覆盖安装后恢复定时并补切（WorkManager 也会自动恢复，这里用于补上漏跑的一轮） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 自动切换提示（通知栏通知）：Android 13+ 需运行时授权，未授权则发不出通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 读取当前系统壁纸（开启接管前存档用）：WallpaperManager.getDrawable/getWallpaperFile
         在 Android 13+ 死认 READ_EXTERNAL_STORAGE（照片权限不折算，真机实测 MagicOS），
         只能靠「所有文件访问」隐式获得该权限，跳系统设置页手动开启 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 检查更新要访问 GitHub（Release 版本查询 + 下载直链）：缺此权限时所有请求
         直接以 SocketException: Permission denied 失败（真机现象：手动检查更新报"权限"错） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App 内下载完更新包后要自己拉起安装页（Android 8+ 起属于「安装未知应用」，
         用户授权一次即可；不走系统下载器是为了进度和安装包都留在 App 里） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 局域网同步的扫码：相机只用来解一帧 640×480 灰度图，不拍照不录像、不写任何文件。
         required=false 让没相机的机器照样能装（那种机器上用「手动输入地址」那条退路收包）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- 只为「现在是不是 Wi-Fi」这一个判断（normal 级、装完即有、不弹框）。
         刻意不申请定位：显示 SSID 才要精确定位，那个权限不该为这功能要。
         起/连局域网服务用的仍是上面已有的 INTERNET，不需要新权限。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- largeHeap：图片解码是本 App 的内存大头（裁剪源图按堆预算最大可到 24MP，
         ARGB_8888 下约 96MB），不申请大堆在中低端机型上容易 OOM -->
    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditActivity"
            android:exported="false" />

        <!-- 局域网同步两页：旧机共享 / 新机接收。接收页锁竖屏 —— 相机预览的旋转矩阵
             因此只需处理传感器 90° 那一种情形，ScanTransform 的夹具也只验那一种（横竖屏切着验不划算）。 -->
        <activity
            android:name=".SyncHostActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SyncJoinActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 1×1 切换格：点一下桌面+锁屏各自切一张；它同时是「30 分钟补切」的时机（见 widget_info.xml），
             android:label 是小组件列表里显示的名字（以前没配，显示的是应用名，加了控制台就两个同名了） -->
        <receiver
            android:name=".WidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 控制台小组件：六格 = 缩略图（点开 App）/ 暂停 / 上一张 / 下一张 / 选库 / 范围翻面，
             动作作用在翻面键选中的那一面（默认桌面）。与 1×1 是两个独立入口（各一份 widget_info），
             1×1 的行为一点没动。
             这里只声明 APPWIDGET_UPDATE 就够：四格的动作广播都把组件写死在 Intent 上（显式广播不过 filter） -->
        <receiver
            android:name=".WidgetConsoleProvider"
            android:exported="false"
            android:label="@string/widget_console_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_console" />
        </receiver>

        <!-- 控制台第三行「选库」那格的选库页：透明主题只弹一列带缩略图的库（行布局与 App 内选库共用），
             背景仍是桌面；给哪一面挑库由小组件用 extra 带进来。
             taskAffinity 留空 = 另起一个任务，不会把 App 主界面顶到前台；excludeFromRecents = 不进最近任务 -->
        <activity
            android:name=".LibPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/LibPickerTheme" />

        <!-- 动态壁纸引擎（Muzei 方案）：被设为动态壁纸后桌面由本引擎直接渲染，
             不再走系统静态壁纸链路，根治 MagicOS "幽灵图"；未激活时自动回退静态方案 -->
        <service
            android:name=".WallSwitchService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- 常驻通知上的「上一张/下一张」按钮（仅应用内部 PendingIntent 触发，不暴露给外部） -->
        <receiver
            android:name=".NotifActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 更新包在 App 私有 cache 里，安装页拿不到裸路径，经此授权一个临时只读 content URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
