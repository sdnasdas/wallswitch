<?xml version="1.0" encoding="utf-8"?>
<!-- 控制台小组件的<b>大档</b>布局：整卡 144×194dp，六格齐高、都是 56dp 正方格。
     与 widget_console.xml（紧凑档 136×170dp）的唯一差别就是格子边长与行高 ——
     <b>view id 必须两边一模一样</b>，WidgetConsoleProvider#buildViews 是一份代码喂两份布局，
     改任何一格的结构 / 图标 / id 都要两份同步改，漏一份的表现是换了档才看出来。

     什么时候用这一档：WidgetConsoleProvider#fitsLarge 读桌面申报的槽位尺寸
     （AppWidgetManager#getAppWidgetOptions），宽高压根都够（含 6dp 余量）才挑它，
     否则用紧凑档。所以这一档"看不看得到"取决于 MagicOS 报不报真数 —— 报的是 widget_info
     里声明的 120×160 时，永远走紧凑档，与 v3.92 之前的表现一致，不会更差。

     为什么六格要齐高（紧凑档第三行是 40dp 矮格）：这一档的目标就是把槽位纵向用满，
     194dp 高正好是三行 56dp + 间距；再矮一行就又在卡里留一条空。
     为什么仍然全写死 dp、不用 weight：见 widget_console.xml 顶部那段（v3.78 的教训）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_console_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/widget_bg"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- 第一行：缩略图（点=打开 App）+ 暂停/继续 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_cell_thumb"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/widget_cell_bg">

                <!-- fitCenter 而不是 centerCrop：位图已在代码里强制裁方，
                     这里不再裁切，万一拿到的是非正方形（老数据）也只留边、不砍头尾 -->
                <ImageView
                    android:id="@+id/widget_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_console_thumb_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_thumb_empty" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_cell_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/widget_cell_bg">

                <!-- 暂停中换成 ic_play（代码里 setImageViewResource），不加文字、不另开一行 -->
                <ImageView
                    android:id="@+id/widget_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="13dp"
                    android:contentDescription="@string/widget_console_pause_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第二行：上一张 + 下一张 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_cell_prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/widget_cell_bg">

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="13dp"
                    android:contentDescription="@string/notif_action_prev"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notif_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_cell_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/widget_cell_bg">

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="13dp"
                    android:contentDescription="@string/notif_action_next"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notif_next" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第三行：选库 + 范围翻面（这一档里它们也是 56dp 正方格，与上面两行齐平） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_cell_lib"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/widget_cell_bg">

                <ImageView
                    android:id="@+id/widget_lib_ic"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_console_lib_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tab_wallpaper" />
            </FrameLayout>

            <!-- 这一格必须有文字：两面没有天然的区分符号，光给图标分不出谁是桌面谁是锁屏 -->
            <LinearLayout
                android:id="@+id/widget_cell_scope"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/widget_cell_bg"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_scope_ic"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/widget_console_scope_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:id="@+id/widget_scope_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/scope_home"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
