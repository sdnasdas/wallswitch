<?xml version="1.0" encoding="utf-8"?>
<!-- 壁纸库行 v3.59：缩略图（该库当前壁纸）+ 库名（点击就地改名）+ N 张壁纸，
     名称下小标签显示该库被哪个范围槽位引用（桌面/锁屏）。
     启用开关与齿轮已移除：设置收进首页顶部两张范围卡片。
     长按行 = 拖拽排序（落位写回 libraries.json）。
     删库走顶栏垃圾桶 → 删除态：行尾露出复选框，勾选后点顶栏勾图标二次确认。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_lib_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_lib_thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/divider"
            android:contentDescription="@string/thumb_desc"
            android:padding="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tab_wallpaper"
            android:tint="@color/text_secondary"
            app:shapeAppearanceOverlay="@style/RoundedThumb" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_lib_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 就地改名：点库名后与上面 TextView 互换可见性 -->
            <EditText
                android:id="@+id/et_lib_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_lib_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- 范围槽位标签：该库被桌面/锁屏卡片引用时才显示 -->
                <TextView
                    android:id="@+id/badge_lib_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="@string/scope_home"
                    android:textColor="@color/brand"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/badge_lib_lock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/badge_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="@string/scope_lock"
                    android:textColor="@color/brand"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 删除态复选框：顶栏垃圾桶进入删除态时显示（点行勾选；长按行 = 拖拽排序） -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_lib_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/lib_delete_check_desc"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
