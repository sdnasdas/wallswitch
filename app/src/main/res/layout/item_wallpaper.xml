<?xml version="1.0" encoding="utf-8"?>
<!-- 壁纸格（v3.14）：两列正方形网格的一格。1:1 缩略图 + 下方标题，右上角一粒成品图格式角标
     （整理态让位给复选框）；
     点格直接进裁剪页重编；长按浮出半透明压暗层与三个圆形图标（铅笔=改标题小窗 /
     设为首页 / 红垃圾桶，无文字），点空白或返回手势收起。
     顶栏「整理」的多选态是另一套手感：右上角复选框显形、勾中的那张整幅压暗，
     长按那一排与进裁剪页都不响应（三个动作在顶栏溢出菜单里，不在格子上加键）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_thumb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/divider"
            android:contentDescription="@string/thumb_desc"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/RoundedGrid" />

        <!-- 长按浮出层：压暗 + 底部居中三个圆形图标（铅笔=改标题小窗 / 设为首页 / 红垃圾桶，无文字）。
             点格本身直接进裁剪页重编，不走这一排。
             关掉裁剪兜底：三个 48dp + 8dp 间距 = 160dp，360dp 宽的屏刚好放得下；
             更窄的屏允许按钮略微越出格子，而不是被裁掉半个圆。 -->
        <FrameLayout
            android:id="@+id/item_actions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/grid_overlay_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_edit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_brand"
                    android:contentDescription="@string/edit_desc"
                    android:padding="12dp"
                    android:src="@drawable/ic_edit"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btn_set_home"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/circle_surface"
                    android:contentDescription="@string/set_as_home"
                    android:padding="12dp"
                    android:src="@drawable/ic_home"
                    android:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btn_delete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/circle_danger"
                    android:contentDescription="@string/delete"
                    android:padding="12dp"
                    android:src="@drawable/ic_delete"
                    android:tint="@android:color/white" />
            </LinearLayout>
        </FrameLayout>

        <!-- 成品图格式角标（PNG / JPEG）：标的是「上屏那张」成品图的格式，不是这张缩略图 ——
             thumbs/<id>.jpg 永远都是 JPEG，写文案时别混。
             排在长按浮出层之后，跟下面那颗复选框同一个理由：要盖在那层压暗之上才看得清。
             整理态由代码隐藏，右上角让给复选框（两粒挤在同一角会互相糊）。 -->
        <TextView
            android:id="@+id/tv_full_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/badge_format_bg"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 实况段角标（LIVE）：标的是「这张带不带实况段」，判的是原图（实况段是原图尾部的
             字节区间，与成品图格式无关），与引擎播实况同一套识别。这类图在桌面上会动，
             提前看得见才不会在库里挑图时误当静态图。
             左上角与右上角那粒并存；整理态与格式角标一起由代码隐藏。 -->
        <TextView
            android:id="@+id/tv_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/badge_format_bg"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone" />

        <!-- 整理多选态的勾选框（顶栏「整理」进来才显形，压在右上角的圆形卡片底上才在深浅图上都看得清）。
             自己不吃点击也不抢焦点：点格子任意处都算勾选，与库行删除态同一条规矩。
             排在长按浮出层之后，是为了让它盖在那层压暗之上。 -->
        <CheckBox
            android:id="@+id/cb_wp_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/circle_surface"
            android:buttonTint="@color/brand"
            android:clickable="false"
            android:focusable="false"
            android:padding="4dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_wallpaper_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />
</LinearLayout>
