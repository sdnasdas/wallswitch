<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面控制台小组件（竖版）的<b>外层</b>：一个 ViewFlipper 装着两个"面"（桌面档 / 锁屏档）。
     卡面本体在 widget_console_card.xml，代码里按面各实例化一份再 addView 进来
     （WidgetConsoleProvider#buildViews）。

     ===== 为什么用 ViewFlipper 而不是自己画淡入淡出 =====
     RemoteViews 没有任何动画入口（一次递交就是一张静态视图，桌面重画就是硬切）。能"换内容带动画"的
     公开路子只有 AdapterViewFlipper（要 RemoteViewsService + 周期心跳，而我们要的是"停在哪就在哪"）
     和 <b>ViewFlipper</b>：它带 @RemoteView（能进小组件布局），ViewAnimator.setDisplayedChild(int)
     带 @RemotableViewMethod（RemoteViews 能直接调），而 showOnly() 里会 startAnimation(in/out) ——
     于是"停在选中的那一面、只在换面时淡一次"正好成立，不引入任何常驻服务或定时器。

     ===== 三条不能改坏的约束 =====
     ① 下面那个首帧占位<b>不能有 id</b>：RemoteViews.removeAllViews 只删"没有稳定 id"的子视图
     （android-34 的 ViewGroupActionRemove.apply 里就是 `if (!hasStableId(child)) removeViewAt(i)`），
     带 id 的会被当成可回收子视图留下 —— 那样运行时再 addView 两面就变成三个子，面序全错。
     ② 卡面那份文件同时用作 widget_info 的 previewLayout（小组件列表里得有东西可看），
     所以它必须能独立 inflate。
     ③ animateFirstView=false：刚贴上那一帧不该淡（走 mFirstTime 那一路），只有之后换面才淡。

     根层透明、flipper wrap_content 居中：桌面给的槽位长宽比不归我们控制，正方格填满一个方向后
     另一个方向必然有余，余下的是透明边、露出壁纸。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_console_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewFlipper
        android:id="@+id/widget_console_flipper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:animateFirstView="false"
        android:inAnimation="@anim/widget_face_in"
        android:outAnimation="@anim/widget_face_out">

        <!-- 首帧占位（无 id，理由见上面①）：桌面在 onUpdate 之前会先 inflate 这一份，
             给一个圆角卡的形状，不至于闪一个空框。尺寸就是地板档那一版卡的大小（120×158dp） -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="158dp"
            android:background="@drawable/widget_bg" />
    </ViewFlipper>
</FrameLayout>
