<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面控制台小组件：2 列 × 3 行。
     上两行是四格（左上=当前壁纸缩略图，点开选库；右上=暂停/继续；左下=上一张；右下=下一张），
     第三行是一整条横键 = 进入 App。四格只作用「桌面」这一面（锁屏仍回 App 里设），
     与 1×1 那格"点一下桌面+锁屏各自切"是有意的差别。

     尺寸为什么全部写死 dp、根层还透明：桌面给的槽位高宽比不归我们控制（一格高 > 宽），
     用 weight 平铺会把每格都拉成长方形 —— 缩略图被裁成竖条、按钮像两块大灰砖。
     所以卡片自己按固定 dp 排、在槽位里居中，多出来的高度透明露出壁纸。

     为什么是 52dp 格 + 40dp 条（v3.79 第一版是 62+62）：真机上 MagicOS 只给了约 2 行高（≈200dp），
     62dp 那版整张卡 214dp 高，底部「进入 App」被切掉一截。现在卡片约 130×170dp，
     2 行还是 3 行的槽位都放得下。不做"读尺寸自适应"：RemoteViews 拿不到也改不了 LayoutParams，
     真要按高度换档只能整份换布局文件，为这一个变量多养一份布局不值得。

     点击目标挂在格子（FrameLayout/LinearLayout）上而不是图标上：图标四周留白也算触控区。
     这里刻意不写任何颜色（背景、android:tint 都不写）：深浅色两档全部由 WidgetConsoleProvider#buildViews
     按我们自己读到的 uiMode 显式挑资源，布局里再写 android:tint 会和 setColorFilter 互相覆盖、看不出谁生效。
     缩略图的圆角也是代码里画进位图的（RemoteViews 不会替 ImageView 裁剪位图）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_console_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/widget_bg"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- 第一行：缩略图（点=选库）+ 暂停/继续 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_cell_lib"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/widget_cell_bg">

                <!-- fitCenter 而不是 centerCrop：位图已在代码里强制裁方，
                     这里不再裁切，万一拿到的是非正方形（老数据）也只留边、不砍头尾 -->
                <ImageView
                    android:id="@+id/widget_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_console_thumb_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_thumb_empty" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_cell_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/widget_cell_bg">

                <!-- 暂停中换成 ic_play（代码里 setImageViewResource），不加文字、不另开一行 -->
                <ImageView
                    android:id="@+id/widget_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="12dp"
                    android:contentDescription="@string/widget_console_pause_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第二行：上一张 + 下一张 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_cell_prev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/widget_cell_bg">

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="12dp"
                    android:contentDescription="@string/notif_action_prev"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notif_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_cell_next"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/widget_cell_bg">

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="12dp"
                    android:contentDescription="@string/notif_action_next"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notif_next" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第三行：一整条「进入 App」。RemoteViews 没有长按 API，所以这个入口只能占一格实位 -->
        <LinearLayout
            android:id="@+id/widget_cell_open"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="3dp"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_open_ic"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/widget_console_open_app"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/widget_open_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_console_open_app"
                android:textColor="@color/widget_ink"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
