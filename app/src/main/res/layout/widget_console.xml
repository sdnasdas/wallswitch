<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面控制台小组件：内部六格 = 2 列 × 3 行。
     第一行 = 当前范围那一面的缩略图（点按打开 App）+ 暂停/继续；
     第二行 = 上一张 + 下一张；
     第三行 = 选库（弹 LibPickerActivity，带当前范围）+ 范围翻面（桌面 ⇄ 锁屏）。
     暂停/上一张/下一张/选库这四格都作用在「当前范围」这一面（v3.92 起；之前四格只认桌面，
     翻面键一按就换一面，范围态存在 settings 的 widget_scope_home，默认桌面）。

     ===== 尺寸是算出来的，不是写死的（v3.95）=====
     每个格子与格子里的图都是 wrap_content，真正的边长由 WidgetConsoleProvider#buildViews 用
     {@code setMinimumWidth/setMinimumHeight} 下发 —— 边长按桌面申报的槽位宽高算
     （getAppWidgetOptions），取"横向放得下 2 格"与"纵向放得下 3 格"里小的那个，夹进 28~64dp，
     所以格子永远是正方（v3.78 用 weight 平铺把格子拉成长方形、缩略图被裁成竖条，那个坑不重踩）。
     换设备、换桌面、改网格密度都不用改这里：读到的数变了，算出来的格子跟着变。

     为什么下面还写着一堆 44dp/24dp：那是**地板值**，只在两种时候生效 ——
     ① 桌面刚 inflate initialLayout、我们第一次渲染还没到；② getAppWidgetOptions 读不到数
     （返回空或 0）时，代码就按地板画，不会再往下塌。
     注意别把格子改成 match_parent 或给图写 layout_width="match_parent"：
     wrap_content 的父 + match_parent 的子 在 RemoteViews 里会把子量成父给的全部空间，
     整张卡会直接撑爆槽位。

     为什么根层透明、卡片 wrap_content 居中：桌面给的槽位长宽比不归我们控制，
     方格算出来填满一个方向后另一个方向必然有余，余下的是透明边、露出壁纸。

     点击目标挂在格子上而不是图标上：图标四周留白也算触控区。
     这里刻意不写任何颜色（背景、android:tint、textColor 都不写）：深浅色两档全部由
     WidgetConsoleProvider#buildViews 按我们自己读到的 uiMode 显式挑资源，布局里再写会和
     setColorFilter / setTextColor 互相覆盖、看不出谁生效。
     缩略图的圆角也是代码里画进位图的（RemoteViews 不会替 ImageView 裁剪位图）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_console_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/widget_bg"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- 第一行：缩略图（点=打开 App）+ 暂停/继续 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_cell_thumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_marginEnd="9dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:background="@drawable/widget_cell_bg">

                <!-- fitCenter 而不是 centerCrop：位图已在代码里强制裁方，
                     这里不再裁切，万一拿到的是非正方形（老数据）也只留边、不砍头尾。
                     缩略图铺满整格，所以它的地板值与格子一样是 44dp -->
                <ImageView
                    android:id="@+id/widget_thumb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:minWidth="44dp"
                    android:minHeight="44dp"
                    android:contentDescription="@string/widget_console_thumb_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_thumb_empty" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_cell_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_marginStart="9dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:background="@drawable/widget_cell_bg">

                <!-- 暂停中换成 ic_play（代码里 setImageViewResource），不加文字、不另开一行。
                     图标只占格子的一半多一点（地板 24dp / 格 44dp），代码里按同一个比例跟着缩放 -->
                <ImageView
                    android:id="@+id/widget_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:minWidth="24dp"
                    android:minHeight="24dp"
                    android:contentDescription="@string/widget_console_pause_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第二行：上一张 + 下一张 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_cell_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_marginEnd="9dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:background="@drawable/widget_cell_bg">

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:minWidth="24dp"
                    android:minHeight="24dp"
                    android:contentDescription="@string/notif_action_prev"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notif_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_cell_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_marginStart="9dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:background="@drawable/widget_cell_bg">

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:minWidth="24dp"
                    android:minHeight="24dp"
                    android:contentDescription="@string/notif_action_next"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notif_next" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第三行：选库 + 范围翻面。原来这里是一整条「进入 App」，
             RemoteViews 没有长按 API 才占了一格实位；现在进 App 挪到左上缩略图，
             这一条腾出来竖切成两格。 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_cell_lib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_marginEnd="9dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:background="@drawable/widget_cell_bg">

                <ImageView
                    android:id="@+id/widget_lib_ic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:minWidth="24dp"
                    android:minHeight="24dp"
                    android:contentDescription="@string/widget_console_lib_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tab_wallpaper" />
            </FrameLayout>

            <!-- 这一格必须有文字：两面没有天然的区分符号，光给图标分不出谁是桌面谁是锁屏。
                 图标与文字竖排，所以撑尺寸时是**这一格自己**吃 setMinimumHeight（子的高度和不一定够），
                 文字本身固定 12sp 不跟着缩放。 -->
            <LinearLayout
                android:id="@+id/widget_cell_scope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_marginStart="9dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:background="@drawable/widget_cell_bg"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_scope_ic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="16dp"
                    android:minHeight="16dp"
                    android:contentDescription="@string/widget_console_scope_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:id="@+id/widget_scope_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/scope_home"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
