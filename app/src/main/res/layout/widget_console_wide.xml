<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面控制台小组件（横版）的<b>外层</b>：一个 ViewFlipper 装着两个"面"（桌面档 / 锁屏档）。
     卡面本体在 widget_console_card_wide.xml，代码里按面各实例化一份再 addView 进来
     （WidgetConsoleProvider#buildViews）。机制与三条约束（首帧占位不能有 id / 卡面文件兼作
     previewLayout / animateFirstView=false）跟竖版一样，理由写在 widget_console.xml 顶上。

     六格等大是硬要求，所以卡面里刻意不用 layout_weight：桌面给的 3×2 槽位长宽比不是 1.5
     （横格比竖格宽），正方格按"横 (槽宽−50)/3 与纵 (槽高−20)/2 取小"算，必然有一个方向画不满，
     剩下的是透明边、露出壁纸。占位仍是 3×2（由 dp 请求决定），跟卡片画多宽无关。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_console_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewFlipper
        android:id="@+id/widget_console_flipper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:animateFirstView="false"
        android:inAnimation="@anim/widget_face_in"
        android:outAnimation="@anim/widget_face_out">

        <!-- 首帧占位（无 id）：地板档那一版横卡的大小（3×44+50=182 宽、2×44+20=108 高） -->
        <FrameLayout
            android:layout_width="182dp"
            android:layout_height="108dp"
            android:background="@drawable/widget_bg" />
    </ViewFlipper>
</FrameLayout>
