<?xml version="1.0" encoding="utf-8"?>
<!-- 常驻切换通知的自绘布局（播放器样式，两行）。
     为什么不用系统媒体卡片：MagicOS 通知栏同时只显示一张媒体卡片，用 MediaStyle 会把音乐 App 的卡挤掉。

     为什么只有两行、且量得这么死：系统把"收起态"的通知裁到 146dp（AOSP dimens 里的
     notification_min_height_increased，targetSdk ≥ 31 走这一档）。算上系统自己那条约 30dp 的头部，
     我们这份视图必须留在 ~110dp 以内，否则超出的部分被裁、就得先点展开才按得到——上一版正是这样：
     封面行 58 + 时间行 22 + 按钮行 54 + 头部 30 = 164dp。
     现在：paddingTop 6 + 封面 40 + paddingTop 2 + 按钮 44 + paddingBottom 6 = 98dp，加头部约 128dp。
     时间因此从单独一行并进第二行末尾；封面 48→40dp。

     第二行那颗 notif_scope 是"这三颗键现在打在哪一面"的角标，点它翻面（桌面 ⇄ 锁屏）。
     角标与三颗键的文字/图标颜色都由代码现挑（RemoteViews 不带主题，见 StatusNotifier#buildViews）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 第一行：封面 + 当前这张的标题 + 「库名 · 模式 · 每 X」＋行尾的下次切换时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp">

        <ImageView
            android:id="@+id/notif_cover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/notif_cover_desc"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/notif_lib"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Chronometer（TextView 子类）：走秒模式当倒计时用，静态模式用 setTextViewText 填时间 -->
                <Chronometer
                    android:id="@+id/notif_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/notif_waiting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_waiting"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- 切换中：锁屏那面走 setBitmap 要解码全图，几秒内没反馈会以为没按着。
                     只在动作超过 400ms 时才亮起来（快的路径根本不画，免得闪一下），
                     亮起时把库名/时间那一坨藏掉，整行高度不变 → 不会因此越过 146dp 的收起裁切线。
                     ProgressBar 自己带 android:indeterminate，SystemUI 在通知可见时逐帧画它 -->
                <LinearLayout
                    android:id="@+id/notif_busy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/notif_busy_bar"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/notif_busy_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/notif_busy"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 第二行：作用面角标 + 上一张 / 暂停·继续 / 下一张。三颗键各占剩余宽度的 1/3、整块可点
         （图标只有 24dp，留白算进触控区才按得到），中间那颗是主键，位置与播放器一致 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/notif_scope"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/notif_chip_bg"
            android:contentDescription="@string/notif_scope_desc"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="@string/scope_home"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notif_prev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="@string/notif_action_prev"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_prev" />

        <ImageView
            android:id="@+id/notif_pause"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="@string/notif_action_pause_desc"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause" />

        <ImageView
            android:id="@+id/notif_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="@string/notif_action_next"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_next" />
    </LinearLayout>
</LinearLayout>
