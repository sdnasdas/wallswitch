<?xml version="1.0" encoding="utf-8"?>
<!-- 常驻切换通知的自绘布局（播放器样式，两行）。
     为什么不用系统媒体卡片：MagicOS 通知栏同时只显示一张媒体卡片，用 MediaStyle 会把音乐 App 的卡挤掉。

     为什么只有两行、且量得这么死：系统把"收起态"的通知裁到 146dp（AOSP dimens 里的
     notification_min_height_increased，targetSdk ≥ 31 走这一档）。算上系统自己那条约 30dp 的头部，
     我们这份视图必须留在 ~110dp 以内，否则超出的部分被裁、就得先点展开才按得到——上一版正是这样：
     封面行 58 + 时间行 22 + 按钮行 54 + 头部 30 = 164dp。
     现在：paddingTop 6 + 封面 40 + paddingTop 2 + 按钮 44 + paddingBottom 6 = 98dp，加头部约 128dp。
     时间因此从单独一行并进第二行末尾；封面 48→40dp。
     v3.103 试过把「一键设置」那颗键叠在角标正下方（左列 28+2+24=54 → 整卡 138dp，离 146 只剩 8dp，
     而 128 与 164 之间本机没实测过），已还原：现在那颗开关占的是**标题那一行**，22dp 高正好被封面的
     40dp 兜住（22 + 2 + 16 = 40），所以整卡还是 128dp，一分不长。

     第二行那颗 notif_scope 是"这三颗键现在打在哪一面"的角标，点它翻面（桌面 ⇄ 锁屏）。
     角标与三颗键的文字/图标颜色都由代码现挑（RemoteViews 不带主题，见 StatusNotifier#buildViews）。
     加东西时只用带 @RemoteView 注解的类：裸 <View> 不在 RemoteViews 白名单里，inflate 抛
     "Class not allowed to be inflated" 的后果不是少一个控件，而是整条通知被 NMS 以 REASON_ERROR
     删掉（v3.83 的 notif_cover_frost 就是这么把通知弄没的）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 第一行：封面 + 当前这张的标题 + 「库名 · 模式 · 每 X」＋行尾的下次切换时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp">

        <!-- 封面 + 压在它身上的「切换中」转圈。转圈放这儿而不是文字行，是因为指针先落定、上屏才慢：
             applyById 第一件事就是写 _current，锁屏那次 setBitmap 要几秒——所以切换中显示的标题/封面
             本来就是"即将上屏的那一张"，转圈盖在封面上正好读成"这张正在应用"，不需要再加文字。
             ProgressBar 自带 android:indeterminate，通知可见时 SystemUI 逐帧画它 -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/notif_cover"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/notif_cover_desc"
                android:scaleType="centerCrop" />

            <!-- 毛玻璃那层veil：切换中盖在封面上，转圈再压在veil上。真高斯模糊在 RemoteViews 里做不到
                 （SystemUI 不会给我们的子 view 加 RenderEffect），所以"毛"是靠代码把封面缩到 1/6 再拉回来
                 近似出来的，这层半透 veil 负责"玻璃"——颜色跟随深浅色（见 @color/notif_frost）。
                 **必须是 FrameLayout 这种带 @RemoteView 注解的类**：裸 <View> 不在 RemoteViews 允许的清单里，
                  inflate 时抛 InflateException("Class not allowed to be inflated android.view.View")，
                 后果不是少一层veil，而是整条通知被 NMS 以 REASON_ERROR 删掉（v3.83 就这么把通知弄没的）。 -->
            <FrameLayout
                android:id="@+id/notif_cover_frost"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/notif_frost"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/notif_busy"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 「一键设置」那颗开关：占掉原来壁纸标题那一行，**紧挨封面**放着（不 push 到行尾），
                 没有配对的文字 —— 状态全靠「钮在左/在右 + 轨道空心/实心」读。
                 点击 PendingIntent 就挂在这个 ImageView 上，可点范围 = 可见范围 = 36×22dp，刻意不撑大。
                 没在抽屉里选过图时整颗 GONE：这一行不留标题也不摆别的东西，位置由封面那 40dp 兜住。
                 22dp 高是算过的：22 + 2 + 下面那行 16 = 40 = 与封面同高，整卡保持约 128dp。
                 两份 layer-list（notif_switch_off / notif_switch_on）照抽屉那颗 MaterialSwitch 的 M3
                 形状等比自绘 —— androidx 的类进不了 RemoteViews（白名单只认 framework 带 @RemoteView 的），
                 真 android.widget.Switch 虽然能画，但颜色不跟 brand、默认 32dp 顶高度、低版本画不出来
                 是整条通知被删，所以不走那条。理由账目见 docs/pinned-one-tap-design.md 第 2 节。 -->
            <ImageView
                android:id="@+id/notif_one_tap_switch"
                android:layout_width="36dp"
                android:layout_height="22dp"
                android:contentDescription="@string/notif_switch_desc"
                android:src="@drawable/notif_switch_off"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/notif_lib"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Chronometer（TextView 子类）：走秒模式当倒计时用，静态模式用 setTextViewText 填时间 -->
                <Chronometer
                    android:id="@+id/notif_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/notif_waiting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_waiting"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 第二行：作用面角标 + 上一张 / 暂停·继续 / 下一张。三颗键各占剩余宽度的 1/3、整块可点
         （图标只有 24dp，留白算进触控区才按得到），中间那颗是主键，位置与播放器一致 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/notif_scope"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/notif_chip_bg"
            android:contentDescription="@string/notif_scope_desc"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="@string/scope_home"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notif_prev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="@string/notif_action_prev"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_prev" />

        <ImageView
            android:id="@+id/notif_pause"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="@string/notif_action_pause_desc"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause" />

        <ImageView
            android:id="@+id/notif_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="@string/notif_action_next"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_next" />
    </LinearLayout>
</LinearLayout>
