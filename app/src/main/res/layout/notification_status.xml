<?xml version="1.0" encoding="utf-8"?>
<!-- 常驻切换通知的自绘布局。为什么不用系统媒体卡片：MagicOS 通知栏同时只显示一张
     媒体卡片，用 MediaStyle 会把音乐 App 的卡挤掉，自绘 RemoteViews 无此冲突。
     收起/展开共用本布局：收起=紧凑单行（图标按钮），展开=多一行大文字按钮。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/notif_cover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/notif_cover_desc"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/notif_lib"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Chronometer
                    android:id="@+id/notif_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/notif_waiting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_waiting"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 收起态按钮：小图标（收起高度放不下大按钮） -->
        <LinearLayout
            android:id="@+id/notif_icon_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notif_prev_ic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/notif_action_prev"
                android:padding="6dp"
                android:src="@drawable/ic_notif_prev" />

            <ImageView
                android:id="@+id/notif_next_ic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/notif_action_next"
                android:padding="6dp"
                android:src="@drawable/ic_notif_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- 展开态按钮：两个大文字按钮（收起态隐藏，图标按钮隐藏） -->
    <LinearLayout
        android:id="@+id/notif_pill_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/notif_prev_pill"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/notif_pill_bg"
            android:gravity="center"
            android:text="@string/notif_action_prev"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notif_next_pill"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/notif_pill_bg"
            android:gravity="center"
            android:text="@string/notif_action_next"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
