<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面 v3.134：单 Activity + 底部三栏（此刻 / 图库 / 设置），抽屉与「库列表首页」下线。
     page_host 里叠着三个一级页，同一时刻只露一页：
       page_now      此刻：桌面/锁屏两张预览卡 + 上一张/暂停/下一张 + 一键设置 + 最近切换
       page_gallery  图库：库卡片网格（长按多选删库，⋯ 里调整顺序）
       page_settings 设置：PreferenceFragmentCompat（原抽屉里那六张卡片）
     page_library / page_settings_secondary / page_switch_log / page_detail 都是 app_root 上的全屏覆盖层，
     旧页与底部导航不重排；图库多选/排序、库内多选仍会收起底部三栏（见 MainActivity#updateBottomNav）。
     胶囊重挂到 main_root 内的浮层，使二级覆盖页能同时遮挡页面和底栏。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <FrameLayout
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/main_column"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <io.github.sdnasdas.wallswitch.GlassSource
                android:id="@+id/page_host"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/page_now"
                    layout="@layout/page_now" />

                <include
                    android:id="@+id/page_gallery"
                    layout="@layout/page_gallery"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/page_settings"
                    android:background="@color/page_bg"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.appbar.MaterialToolbar
                        android:id="@+id/toolbar_settings"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        app:title="@string/tab_settings"
                        app:titleCentered="true"
                        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/settings_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </io.github.sdnasdas.wallswitch.GlassSource>

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemIconTint="@color/bottom_nav_icon"
                app:itemTextColor="@color/text_primary"
                app:menu="@menu/bottom_nav" />
        </LinearLayout>

        <io.github.sdnasdas.wallswitch.LiquidGlassView
            android:id="@+id/nav_glass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:elevation="6dp"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/page_settings_secondary"
        layout="@layout/page_settings_secondary"
        android:visibility="gone" />

    <!-- 日志留在底层；从日志定位进库时直接盖上 page_library，返回即可原路露出日志。 -->
    <include
        android:id="@+id/page_switch_log"
        layout="@layout/page_switch_log"
        android:visibility="gone" />

    <include
        android:id="@+id/page_library"
        layout="@layout/page_library"
        android:visibility="gone" />

    <!-- 库内多选动作栏（v3.188 起悬浮胶囊，只放图标）：出现时顶替底部导航。
         从左到右：收藏 / 保存到相册 / 设为壁纸（恰好勾一张才可点）/ 移出本库（红）/ 更多。
         「更多」里是 移动到、复制到、设为封面、夜间禁用、详细信息（见 MainActivity#showSelectionMore）。
         长按每颗都有文字提示，读屏念 contentDescription。底边距由 setupInsets 按系统栏补上 -->
    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/sel_pill_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/sel_fav"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sel_fav"
            android:src="@drawable/ic_sel_heart"
            android:tooltipText="@string/sel_fav"
            app:tint="@color/fav_heart" />

        <ImageButton
            android:id="@+id/sel_save"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sel_save"
            android:src="@drawable/ic_sel_save"
            android:tooltipText="@string/sel_save"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/sel_set_wallpaper"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/design_set_wallpaper"
            android:src="@drawable/ic_sel_set_wallpaper"
            android:tooltipText="@string/design_set_wallpaper"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/sel_remove"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sel_remove_lib"
            android:src="@drawable/ic_sel_trash"
            android:tooltipText="@string/sel_remove_lib"
            app:tint="?attr/colorError" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/sel_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sel_more"
                android:src="@drawable/ic_sel_more"
                android:tooltipText="@string/sel_more"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>
    </LinearLayout>

    <include
        android:id="@+id/page_detail"
        layout="@layout/page_detail"
        android:visibility="gone" />
</FrameLayout>
