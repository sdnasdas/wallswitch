<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面 v3.134：单 Activity + 底部三栏（此刻 / 图库 / 设置），抽屉与「库列表首页」下线。
     page_host 里叠着三个一级页，同一时刻只露一页：
       page_now      此刻：桌面/锁屏两张预览卡 + 上一张/暂停/下一张 + 一键设置 + 最近切换
       page_gallery  图库：库卡片网格（长按多选删库，⋯ 里调整顺序）
       page_settings 设置：PreferenceFragmentCompat（原抽屉里那六张卡片）
     page_library / page_settings_secondary / page_switch_log / page_detail 都是 app_root 上的全屏覆盖层，
     旧页与底部导航不重排；图库多选/排序、库内多选仍会收起底部三栏（见 MainActivity#updateBottomNav）。
     系统栏避让：main_root 只吃上/左/右，底部由 BottomNavigationView 自己按导航条加内边距；
     三栏收起时没人垫底部，改由 main_root 自己垫（MainActivity#applyBottomInset）；
     全屏覆盖层分别处理自己的 Insets（见 MainActivity#setupInsets）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/page_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/page_now"
                layout="@layout/page_now" />

            <include
                android:id="@+id/page_gallery"
                layout="@layout/page_gallery"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/page_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar_settings"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:title="@string/tab_settings"
                    app:titleCentered="true"
                    app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/settings_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:itemIconTint="@color/bottom_nav_icon"
            app:itemTextColor="@color/text_primary"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>

    <include
        android:id="@+id/page_library"
        layout="@layout/page_library"
        android:visibility="gone" />

    <!-- 库内多选动作条浮在覆盖层上；出现时顶替底部导航。
         「设为封面」只在恰好勾了一张时可点；勾的那张已经是封面时文案换成「取消封面」 -->
    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <Button
            android:id="@+id/sel_move"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sel_move"
            app:icon="@drawable/ic_move"
            app:iconGravity="top" />

        <Button
            android:id="@+id/sel_copy"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sel_copy"
            app:icon="@drawable/ic_copy"
            app:iconGravity="top" />

        <Button
            android:id="@+id/sel_cover"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sel_cover"
            app:icon="@drawable/ic_cover"
            app:iconGravity="top" />

        <Button
            android:id="@+id/sel_remove"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sel_remove"
            android:textColor="?attr/colorError"
            app:icon="@drawable/ic_remove_circle"
            app:iconGravity="top"
            app:iconTint="?attr/colorError" />
    </LinearLayout>

    <include
        android:id="@+id/page_settings_secondary"
        layout="@layout/page_settings_secondary"
        android:visibility="gone" />

    <!-- 切换记录是全屏二级页，盖住主页面与底部导航；详情页仍放最后，必要时可盖在日志之上 -->
    <include
        android:id="@+id/page_switch_log"
        layout="@layout/page_switch_log"
        android:visibility="gone" />

    <include
        android:id="@+id/page_detail"
        layout="@layout/page_detail"
        android:visibility="gone" />
</FrameLayout>
