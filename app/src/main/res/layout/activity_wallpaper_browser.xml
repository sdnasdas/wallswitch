<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/browser_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/menu_wallpaper_browser"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/browse_wallpapers"
        app:subtitle="@string/browse_provider" />

    <ProgressBar
        android:id="@+id/browser_page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:visibility="gone" />

    <WebView
        android:id="@+id/wallpaper_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/browser_download_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/browser_download_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/browse_downloading"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <ProgressBar
            android:id="@+id/browser_download_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            android:max="100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browser_cancel_download"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/browse_download_cancel" />
    </LinearLayout>
</LinearLayout>
