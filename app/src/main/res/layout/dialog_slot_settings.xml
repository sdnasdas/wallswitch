<?xml version="1.0" encoding="utf-8"?>
<!-- 范围卡片齿轮弹出的聚合设置：本范围的壁纸库（下拉直接换）、切换模式（顺序/随机）、
     切换间隔（整行可点，弹时/分滚轮）。改动即保存。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/slot_lib_label"
        android:textColor="@color/brand"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 当前占位库：缩略图 + 库名 + 下拉箭头，点按弹出带图的库选择列表 -->
    <LinearLayout
        android:id="@+id/row_slot_lib"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/picker_row_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_slot_lib_thumb"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@color/divider"
            android:contentDescription="@string/thumb_desc"
            android:padding="9dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tab_wallpaper"
            android:tint="@color/text_secondary"
            app:shapeAppearanceOverlay="@style/RoundedThumb" />

        <TextView
            android:id="@+id/tv_slot_lib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/slot_lib_label"
            android:src="@drawable/ic_arrow_drop_down"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/lib_mode_title"
        android:textColor="@color/brand"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_order"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_random"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/mode_random"
            android:textSize="14sp" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/row_interval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lib_interval_label"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_interval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 卡片配色：色相 + 浓淡两条滑杆（条上的渐变由代码画），下面那块小卡片实时跟着变 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/slot_theme_label"
        android:textColor="@color/brand"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:text="@string/slot_theme_hue"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/sb_slot_hue"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:text="@string/slot_theme_tone"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/sb_slot_tone"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 预览：跟真卡片同一套颜色（底 + 描边 + 三行文字 + 缩略图位 + 暂停键），挑色时当场看字够不够清楚 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_slot_preview"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:id="@+id/img_slot_preview_thumb"
                android:layout_width="44dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tv_slot_preview_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slot_home_title"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_slot_preview_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/slot_preview_name"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_slot_preview_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/slot_preview_desc"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/img_slot_preview_pause"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/slot_pause_bg"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_pause" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
