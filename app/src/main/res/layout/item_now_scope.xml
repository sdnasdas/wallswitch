<?xml version="1.0" encoding="utf-8"?>
<!-- 此刻页的一面：整张照片就是卡片，面名与设置叠在顶部，库名、切换规则、三颗控制与下次时间叠在底部。
     上下薄渐隐保证亮图也读得清，字固定中性白；点图仍开这一面的详情与设置入口。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    app:cardBackgroundColor="@color/now_card_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:id="@+id/now_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/now_card_bg"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_now_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/thumb_desc"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedNowCard" />

        <View
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_now_scope"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    app:tint="@color/image_ink" />

                <TextView
                    android:id="@+id/tv_now_scope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/image_ink" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_now_settings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/image_tool_bg"
                android:contentDescription="@string/design_scope_settings"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                app:tint="@color/image_ink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_now_lib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="4dp"
                android:drawableTint="@color/image_ink"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minHeight="34dp"
                android:paddingStart="2dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/image_ink" />

            <TextView
                android:id="@+id/tv_now_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/image_ink_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_now_prev"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:contentDescription="@string/notif_action_prev"
                    app:icon="@drawable/ic_skip_previous"
                    app:iconTint="@color/image_ink" />

                <Button
                    android:id="@+id/btn_now_pause"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/design_pause_switch"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    app:backgroundTint="@color/image_control_bg"
                    app:icon="@drawable/ic_pause"
                    app:iconGravity="textStart"
                    app:iconTint="@color/image_ink" />

                <Button
                    android:id="@+id/btn_now_next"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:contentDescription="@string/notif_action_next"
                    app:icon="@drawable/ic_skip_next"
                    app:iconTint="@color/image_ink" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_now_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="4dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/image_ink_dim" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
