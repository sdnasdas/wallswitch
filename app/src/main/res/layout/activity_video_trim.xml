<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_trim_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/video_trim_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/video_trim_title"
        app:titleTextColor="@color/text_primary" />

    <LinearLayout
        android:id="@+id/video_trim_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/video_trim_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/black">

            <androidx.media3.ui.PlayerView
                android:id="@+id/video_trim_player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <ImageView
                android:id="@+id/video_trim_cover_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/video_trim_cover"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/video_trim_busy"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/video_trim_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/video_trim_range"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/video_trim_range_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/video_trim_limit"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/video_trim_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="80dp">
                    <LinearLayout
                        android:id="@+id/video_trim_thumbnails"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/divider"
                        android:orientation="horizontal" />
                    <View
                        android:id="@+id/video_trim_shade_left"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        android:background="#88000000"
                        android:importantForAccessibility="no" />
                    <View
                        android:id="@+id/video_trim_shade_right"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        android:background="#88000000"
                        android:importantForAccessibility="no" />
                    <View
                        android:id="@+id/video_trim_range_window"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no" />
                    <View
                        android:id="@+id/video_trim_cover_marker"
                        android:layout_width="2dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center_vertical"
                        android:background="#FFE08A"
                        android:importantForAccessibility="no" />
                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/video_trim_range_slider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/video_trim_range"
                        android:enabled="false"
                        android:valueFrom="0"
                        android:valueTo="1"
                        app:haloRadius="12dp"
                        app:labelBehavior="gone"
                        app:thumbColor="@color/brand"
                        app:thumbRadius="10dp"
                        app:trackColorActive="@color/brand"
                        app:trackColorInactive="#55000000"
                        app:trackHeight="3dp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/video_trim_cover"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/video_trim_cover_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/video_trim_cover_slider"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:contentDescription="@string/video_trim_cover"
                    android:enabled="false"
                    android:valueFrom="0"
                    android:valueTo="1"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/brand"
                    app:trackColorActive="@color/brand"
                    app:trackColorInactive="@color/divider" />

                <TextView
                    android:id="@+id/video_trim_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_trim_loading"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/video_trim_play"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/video_trim_play" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/video_trim_cancel"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cancel" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/video_trim_confirm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/video_trim_confirm" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
