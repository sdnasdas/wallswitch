<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件「翻面」格图标 —— 锁屏档：下面那张卡片实心（= 当前管锁屏），上面那张只描边。
     与 ic_scope_card_home.xml 逐条同构：两张卡片的外沿都是 x2.5~21.5、y3~11 / y13~21，
     描边那张同样内缩 0.85，只有"实心 + 洞"从上半换到下半 —— 否则翻面时整颗图标会跳位置。
     居中账：下卡片中心 (12, 17.0)，锁的包围盒 x9.6~14.4 / y14.95~19.05 → 中心正好 (12.0, 17.0)，
     上下各留 1.95、左右各留 2.4（两间各自对自己那张卡片对称即可，留白不必相等）。
     锁为什么自己画而不用现成的 ic_lock：ic_lock 的路径里有贝塞尔曲线，而抠洞要求锁的形状跟卡片矩形
     写在同一条 pathData 里（evenOdd），手写变换容易歪；这里用圆角矩形 + 两段半圆拼，坐标能直接算准。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 上半：非当前面 —— 只描边，矩形内缩 0.85 让外沿与实心那张对齐 -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:pathData="M5,3.85 L19,3.85 A1.65,1.65 0 0 1 20.65,5.5 L20.65,8.5 A1.65,1.65 0 0 1 19,10.15 L5,10.15 A1.65,1.65 0 0 1 3.35,8.5 L3.35,5.5 A1.65,1.65 0 0 1 5,3.85 Z" />

    <!-- 下半：当前面 —— 实心卡片 + 锁的透明洞。三条子路径写在同一条 pathData 里做 evenOdd：
         ① 卡片矩形 y13~21；② 锁环（外半圆 r1.5 峰在 y14.95、内半圆 r0.6 峰在 y15.85，带宽 0.9，
         坐在锁体顶边 y16.45 上）；③ 锁体 x9.6~14.4、y16.45~19.05、圆角 0.5 -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M5,13 L19,13 A2.5,2.5 0 0 1 21.5,15.5 L21.5,18.5 A2.5,2.5 0 0 1 19,21 L5,21 A2.5,2.5 0 0 1 2.5,18.5 L2.5,15.5 A2.5,2.5 0 0 1 5,13 Z M10.5,16.45 A1.5,1.5 0 0 1 13.5,16.45 L12.6,16.45 A0.6,0.6 0 0 0 11.4,16.45 Z M10.1,16.45 L13.9,16.45 A0.5,0.5 0 0 1 14.4,16.95 L14.4,18.55 A0.5,0.5 0 0 1 13.9,19.05 L10.1,19.05 A0.5,0.5 0 0 1 9.6,18.55 L9.6,16.95 A0.5,0.5 0 0 1 10.1,16.45 Z" />
</vector>
