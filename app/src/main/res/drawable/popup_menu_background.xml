<?xml version="1.0" encoding="utf-8"?>
<!-- 全 App 的 Toolbar 溢出菜单/下拉菜单：M3 高层容器 + 16dp 圆角 + 轻描边。
     padding 是菜单内容与圆角边缘之间的安全距离，避免第一/最后一行贴边。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
    <corners android:radius="16dp" />
    <padding android:left="4dp" android:top="6dp" android:right="4dp" android:bottom="6dp" />
</shape>
