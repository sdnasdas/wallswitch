<?xml version="1.0" encoding="utf-8"?>
<!-- 控制台小组件里一格的样子：比卡片底色略深一档的圆角方块，让人看得出"这是个能按的格子"。
     浅色档取 widget_cell（半透黑）；深色档是 widget_cell_bg_night（半透白，深底上要亮一档才看得出是键），
     由代码按 uiMode 挑，原因见 colors.xml。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_cell" />
    <corners android:radius="12dp" />
</shape>
