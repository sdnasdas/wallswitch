<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件「翻面」格图标 —— 锁屏档：竖胶囊里下半（锁屏）被选中。
     形状、尺寸、算式与 ic_scope_pill_home.xml 逐条对齐，只把「淡底块 + 实心」从上半换到下半：
     两份文件必须除了 alpha 之外完全同形，否则翻面时整颗图标会跳位置。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.4"
        android:pathData="M7,7.2A5,5 0 0 1 17,7.2L17,16.8A5,5 0 0 1 7,16.8Z" />

    <!-- 当前那半的淡底块：下半 x 8.8~15.2、y 13.0~20.2（中心 12,16.6 与锁对齐）。
         与 home 那份的上下半完全同形，只是淡底块换到下面 —— 两份文件除了 alpha 分布之外
         必须逐条对得上，否则翻面时整颗图标会跳位置 -->
    <path
        android:fillColor="#FF000000"
        android:fillAlpha="0.22"
        android:pathData="M8.8,16.2A3.2,3.2 0 0 1 15.2,16.2L15.2,17.0A3.2,3.2 0 0 1 8.8,17.0Z" />

    <!-- 房子：这一半没被选中，32% 淡 -->
    <group
        android:scaleX="0.26"
        android:scaleY="0.26"
        android:translateX="8.88"
        android:translateY="4.41">
