<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件「翻面」格图标 —— 桌面档：上下两张横卡片，上面那张实心（= 当前管桌面），下面那张只描边。
     为什么换成这个形状：v3.97 那版竖胶囊在 24 视口里只占 10 宽 × 19.6 高，落到 64dp 格子里就是
     约 14×28dp 的一条（宽度只用掉格子的 22%），真机截图上就是"图标太小"。这一版两张卡片外沿
     占 x2.5~21.5（79%）、y3~21（75%），铺满整格。
     状态靠"哪张实心"传，不含需要认的小图形；实心那张里再抠一个透明洞写明白是哪一面
     （桌面=房子，锁屏=锁，另一态见 ic_scope_card_lock.xml）。
     洞为什么必须是透明洞：小组件上色走 setColorFilter（SRC_ATOP 只换 RGB、保 alpha），
     涂白会被染成跟实心块同一色、等于没画。所以卡片矩形与房子写在同一个 <path> 里，
     用 fillType="evenOdd" 让重叠部分抠空。
     两条对齐账（都是硬要求，改的时候别只改一边）：
       ① 描边那张的矩形要往内缩半个描边宽（1.7/2=0.85），否则描边的中心线落在实心块的外沿上，
          看着会比实心那张大一圈；缩完之后两张的<b>外沿</b>都是 x2.5~21.5、y3~11 / y13~21。
       ② 洞要对自己那张卡片正中：上卡片中心 (12, 7.0)，房子按 0.28 缩放后包围盒
          x9.2~14.8 / y4.62~9.38 → 中心正好 (12.0, 7.0)，四边各留 1.62 / 2.4。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 上半：当前面 —— 实心卡片 + 房子透明洞 -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M5,3 L19,3 A2.5,2.5 0 0 1 21.5,5.5 L21.5,8.5 A2.5,2.5 0 0 1 19,11 L5,11 A2.5,2.5 0 0 1 2.5,8.5 L2.5,5.5 A2.5,2.5 0 0 1 5,3 Z M11.44,9.38 L11.44,7.7 L12.56,7.7 L12.56,9.38 L13.96,9.38 L13.96,7.14 L14.8,7.14 L12,4.62 L9.2,7.14 L10.04,7.14 L10.04,9.38 Z" />

    <!-- 下半：非当前面 —— 只描边，矩形内缩 0.85 让外沿与实心那张对齐 -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:pathData="M5,13.85 L19,13.85 A1.65,1.65 0 0 1 20.65,15.5 L20.65,18.5 A1.65,1.65 0 0 1 19,20.15 L5,20.15 A1.65,1.65 0 0 1 3.35,18.5 L3.35,15.5 A1.65,1.65 0 0 1 5,13.85 Z" />
</vector>
