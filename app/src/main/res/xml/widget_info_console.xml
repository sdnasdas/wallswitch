<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 控制台小组件。
     尺寸按官方换算式 70n + (n−1)×10 − 30：1 格 = 40dp（与 1×1 那个对得上），2 格 = 120dp。
     updatePeriodMillis=0 是刻意的：1×1 那格把"桌面每 30 分钟刷一次小组件"当成补切时机（见 widget_info.xml），
     这里若也按 30 分钟排，同一时刻就会跑两遍补切 —— 多一次唤醒对发热没有好处。
     控制台的刷新全部挂在已有的 WidgetProvider.updateWidget 调用点上（切换/暂停/换库/开机恢复）。
     resizeMode=none：四格是按 2×2 排的，拉成 2×1 或 3×2 只会把格子拧歪。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_console_desc"
    android:initialLayout="@layout/widget_console_2x2"
    android:minWidth="120dp"
    android:minHeight="120dp"
    android:previewImage="@drawable/ic_widget_switch"
    android:previewLayout="@layout/widget_console_2x2"
    android:resizeMode="none"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
