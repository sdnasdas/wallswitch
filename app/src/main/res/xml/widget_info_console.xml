<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面控制台小组件：宽 2 格 × 高 2 格（六格：上两行四格动作 + 第三行选库与范围翻面）。
     尺寸按官方换算式 70n + (n−1)×10 − 30：宽 2 格 = 120dp，高 2 格 = 120dp；
     这里 minHeight 给到 160dp 而不是 120dp，是为了让"按 minHeight 折算行数"的桌面也至少给 2 行
     （卡片自己排出来约 136×170dp，见 widget_console.xml 顶部：v3.92 把两列间距从 6dp 拉到 18dp，
     因为真机照片量下来槽位约 142dp 宽、124dp 的卡片右边白一圈、两列挤着看着像被拉窄）。
     v3.79 第一版声明的是 2×3（minHeight 200dp）：真机上 MagicOS 只给了约 2 行高，
     底部那条「进入 App」被切掉一截 —— 改成卡片缩到 170dp 高、按 2 行要位，2 行 3 行都放得下。
     内容不由这两个值决定：卡片在布局里按固定 dp 自排并居中，槽位再高也只是多露透明边。
     updatePeriodMillis=0 是刻意的：1×1 那格把"桌面每 30 分钟刷一次小组件"当成补切时机（见 widget_info.xml），
     这里若也按 30 分钟排，同一时刻就会跑两遍补切 —— 多一次唤醒对发热没有好处。
     控制台的刷新全部挂在已有的 WidgetProvider.updateWidget 调用点上（切换/暂停/换库/翻面/深浅色翻档/开机恢复）。
     resizeMode=none：格位是按 2×2 排的，拉成别的形状只会把格子拧歪。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_console_desc"
    android:initialLayout="@layout/widget_console"
    android:minWidth="120dp"
    android:minHeight="160dp"
    android:previewImage="@drawable/ic_widget_switch"
    android:previewLayout="@layout/widget_console"
    android:resizeMode="none"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
