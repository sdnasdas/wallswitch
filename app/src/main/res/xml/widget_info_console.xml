<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面控制台小组件：向桌面要 <b>2 列 × 2 行</b>，内部六格 = 2 列 × 3 行
     （上两行四格动作 + 第三行选库与范围翻面）。
     <b>桌面列表里那个"几×几"是按官方换算式 round((dp+30)/70) 从下面两个 min 值推出来的，
     targetCellWidth/Height 它根本没看</b>：120dp → 2.14 → 2；160dp → 2.71 → 3。
     v3.80~v3.94 期间 minHeight 写的是 160dp，所以那几版其实一直占着 3 行（当时留 160 的理由
     "至少给 2 行"是错的），卡片上下那圈空档就是这么来的。现在压回 120dp 要回 2×2。

     <b>为什么敢压：卡片不再按固定 dp 画了。</b>格子边长由 WidgetConsoleProvider#cellDpFor
     按桌面报回来的真实槽位现算（横向扣 32dp 开销除以 2 格、纵向扣 26dp 除以 3 行，取小的当正方格，
     夹进 28~64dp），读不到申报值就落 44dp 地板。所以"这台机器的 2 行到底多高"不需要提前知道 ——
     给得下就画大，给不下就画小，两种都不会切图。v3.79 那次 214dp 卡片被切、v3.93 那版靠两档赌阈值，
     都是因为尺寸是写死的。

     updatePeriodMillis=0 是刻意的：1×1 那格把"桌面每 30 分钟刷一次小组件"当成补切时机（见 widget_info.xml），
     这里若也按 30 分钟排，同一时刻就会跑两遍补切 —— 多一次唤醒对发热没有好处。
     控制台的刷新全部挂在已有的 WidgetProvider.updateWidget 调用点上（切换/暂停/换库/翻面/深浅色翻档/开机恢复），
     外加 onAppWidgetOptionsChanged（放置、换桌面、改网格密度、旋转都会走）。
     resizeMode=none：六格是按 2 列 × 3 行算的，拉成别的形状只会把格子拧歪 ——
     要改可用空间请改上面两个 min 值，然后让算法去适配。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_console_desc"
    android:initialLayout="@layout/widget_console"
    android:minWidth="120dp"
    android:minHeight="120dp"
    android:previewImage="@drawable/ic_widget_switch"
    android:previewLayout="@layout/widget_console"
    android:resizeMode="none"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
