<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面控制台小组件（横版）：向桌面要 <b>3 列 × 2 行</b>，内部六格 = 3 列 × 2 行等大正方。

     为什么是 180dp × 120dp：MagicOS 只按 dp 折算格位（round((dp+30)/70)），不看 targetCell*。
     这条有对照证据 —— v3.94/v3.95 的 targetCellHeight 一直是 2，只把 minHeight 从 160dp 改到
     120dp，真机占位就从 3 行变 2 行；(160+30)/70=2.71→3、(120+30)/70=2.14→2 都能对上。
     要 3 列 → dp 落在 145~215 这一档，取 180（(180+30)/70=3.0）；要 2 行 → 120dp（已验过两回）。
     targetCellWidth/Height 照样写：这台机器的桌面不看它，但认它的桌面（AOSP/第三方）能直接按格数摆，
     写了不亏。

     resizeMode 这里开成 horizontal|vertical（竖版那格仍是 none）：目的是接住"以后改了桌面图标
     布局（比如 4×6 → 5×6），同一个 dp 请求换算是几格就不由我们定了"这一档 —— 与其赌 dp 数值，
     不如让用户自己把它拉回 3×2。当年关 resize 的理由是"六格尺寸写死、拉一拉就拧歪"，
     那条已经随 v3.95 的运行时算边长失效：格子始终正方，拉多大只影响四周透明边的多寡。
     minResizeWidth/Height 给 145/90dp：按这一下限算格子是 (145-50)/3=31dp、(90-20)/2=35dp，
     取小 31dp，还在 28dp 地板之上，不至于缩成一坨。

     格子边长由 WidgetConsoleProvider#cellDpFor 按桌面报回来的真实槽位现算
     （横向扣 50dp 开销除 3 格、纵向扣 20dp 除 2 行，取小的当正方格，夹进 28~84dp），
     读不到申报值落 44dp 地板（等于卡片 182×108dp）。所以"这台机器的 3 列多宽、2 行多高"
     不需要提前知道 —— 给得下就画大，给不下就画小，两种都不会切图。

     updatePeriodMillis=0 是刻意的：补切时机归 1×1 那格一份（见 widget_info.xml），这里再排一份
     同一刻就跑两遍。刷新全部挂在 WidgetProvider.updateWidget 那个调用点上
     （切换/暂停/换库/翻面/深浅色翻档/开机恢复），外加 onAppWidgetOptionsChanged
     （放置、拖动改尺寸、换桌面、改网格密度、旋转都会走）。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_console_wide_desc"
    android:initialLayout="@layout/widget_console_wide"
    android:minWidth="180dp"
    android:minHeight="120dp"
    android:minResizeWidth="145dp"
    android:minResizeHeight="90dp"
    android:previewImage="@drawable/ic_widget_switch"
    android:previewLayout="@layout/widget_console_card_wide"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
