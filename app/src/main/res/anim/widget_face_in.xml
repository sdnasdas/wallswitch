<?xml version="1.0" encoding="utf-8"?>
<!-- 翻面淡化：新面进场用的淡入。
     为什么只能"淡入"不能"交叉淡化"：ViewAnimator.showOnly() 给旧的那面 startAnimation(out) 之后
     <b>立刻 setVisibility(GONE)</b>（android-34 源码里就那几行），旧面当场就没了、动画根本画不出来，
     所以真机上是"旧面消失 + 新面淡入"。out 那份仍配上，万一哪版框架改成延迟隐藏就是交叉淡化，
     我们不用动代码。 -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:fromAlpha="0.0"
    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
    android:toAlpha="1.0" />
