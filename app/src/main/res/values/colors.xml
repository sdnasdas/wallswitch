<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 自适应图标背景色：启动图标保持原样，不跟随界面中性配色 -->
    <color name="ic_launcher_background">#1E88E5</color>

    <!-- 浅色 UI 配色（中性灰：不带蓝，也不带棕/暖）。
         普通文字统一 #262626、次级 #6B6B6B；强调色只给选中、主按钮和关键操作。
         page_bg / card_bg / text_* 这些老名字仍在小组件、通知、裁剪页里引用 -->
    <color name="brand">#4A4A4A</color>
    <color name="page_bg">#F2F2F2</color>
    <color name="card_bg">#FFFFFF</color>
    <!-- 亮色模式：普通文字与图标纯黑；暗色档为纯白 -->
    <color name="text_primary">#000000</color>
    <color name="text_secondary">#000000</color>
    <color name="icon_neutral">#000000</color>

    <!-- 此刻页沉浸卡片：字与控件压在照片上，固定用中性白，不跟随深浅色或强调色 -->
    <color name="image_ink">#FFFFFF</color>
    <color name="image_ink_dim">#CCFFFFFF</color>
    <color name="image_tool_bg">#4D000000</color>
    <color name="image_control_bg">#33FFFFFF</color>
    <!-- 调整取景页直接贴在原图上的浮动键底色（圆键与胶囊键共用），取代原来上下两整条 #B3000000 -->
    <color name="edit_float_bg">#80000000</color>
    <!-- 多选「已勾选」专用蓝（用户点名要蓝勾：中性灰勾在照片上不显眼）。全局仍是中性灰，
         蓝色只给「选中」这一件事：勾、选中格描边 -->
    <color name="select_blue">#1A73E8</color>
    <color name="now_card_bg">#1A1A1A</color>

    <!-- 完整 Material3 颜色角色：中性灰阶 + 石墨灰强调（不带蓝、不带暖）。
         夜间档见 values-night/colors.xml；两边保持同样的层级关系 -->
    <color name="m3_primary">#4A4A4A</color>
    <color name="m3_on_primary">#FFFFFF</color>
    <color name="m3_primary_container">#E7E7E7</color>
    <color name="m3_on_primary_container">#000000</color>
    <color name="m3_secondary">#5C5C5C</color>
    <color name="m3_on_secondary">#FFFFFF</color>
    <color name="m3_secondary_container">#E7E7E7</color>
    <color name="m3_on_secondary_container">#000000</color>
    <color name="m3_tertiary">#6A6A6A</color>
    <color name="m3_on_tertiary">#FFFFFF</color>
    <color name="m3_tertiary_container">#EDEDED</color>
    <color name="m3_on_tertiary_container">#000000</color>
    <color name="m3_error">#BA1A1A</color>
    <color name="m3_on_error">#FFFFFF</color>
    <color name="m3_error_container">#FFDAD6</color>
    <color name="m3_on_error_container">#410002</color>
    <color name="m3_surface">#F2F2F2</color>
    <color name="m3_on_surface">#000000</color>
    <color name="m3_surface_variant">#E3E3E3</color>
    <color name="m3_on_surface_variant">#000000</color>
    <color name="m3_outline">#8A8A8A</color>
    <color name="m3_outline_variant">#DCDCDC</color>
    <!-- 卡片/底部面板/菜单/弹窗用纯白，页面底 #F2F2F2 衬出层级（参照 Qoder 移动端） -->
    <color name="m3_surface_container_lowest">#FFFFFF</color>
    <color name="m3_surface_container_low">#FFFFFF</color>
    <color name="m3_surface_container">#FAFAFA</color>
    <color name="m3_surface_container_high">#FFFFFF</color>
    <color name="m3_surface_container_highest">#EDEDED</color>
    <color name="m3_surface_dim">#E6E6E6</color>
    <color name="m3_surface_bright">#FFFFFF</color>
    <color name="m3_inverse_surface">#2E2E2E</color>
    <color name="m3_inverse_on_surface">#F2F2F2</color>
    <color name="m3_inverse_primary">#D6D6D6</color>
    <!-- 单张详情那一页（全屏看图）的底与顶/底栏渐隐：深浅档都用黑，图是主角 -->
    <color name="viewer_bg">#FF000000</color>
    <color name="viewer_scrim">#99000000</color>
    <!-- 小组件配色：浅色 / 深色两档都在这一份里定死，**刻意不做 values-night 变体**。
         原因：深浅色切换时桌面会不会重画已摆着的小组件、重画时按哪一档配置解析，各家 ROM 不保证，
         光靠资源自动翻有停在旧档的风险。改成由代码按我们自己进程读到的 uiMode 挑一次
         （浅色挑无后缀那组、深色挑 _night 那组，见 WidgetConsoleProvider#isNight），
         与桌面配不配合无关。深色档对齐 App 夜间层级（card_bg #1E1E1E / text_primary #E6E6E6）；
         格子与空态在深底上要"亮一档"（半透白）才看得出那是个键。
         对照：常驻通知里用 text_primary 是对的——通知整张卡跟随深浅色，且它的 RemoteViews 每次都由
         我们进程重算重发，不存在"停在旧档"这个问题。 -->
    <color name="widget_card">#F2FFFFFF</color>
    <color name="widget_card_night">#F21E1E1E</color>
    <color name="widget_cell">#0A000000</color>
    <color name="widget_cell_night">#1AFFFFFF</color>
    <color name="widget_empty">#24000000</color>
    <color name="widget_empty_night">#33FFFFFF</color>
    <color name="widget_ink">#000000</color>
    <color name="widget_ink_night">#FFFFFF</color>
    <color name="divider">#E0E0E0</color>
    <color name="danger">#D93025</color>
    <!-- 通知封面「切换中」那层毛玻璃 veil：浅色档压一层半透白，深色档压一层半透墨（各自都让转圈看得清） -->
    <color name="notif_frost">#66FFFFFF</color>
    <!-- 常驻通知上那颗作用面角标的文字色：桌面用中性石墨灰，锁屏用鼠尾草绿区分，两色在浅底深底上都够对比 -->
    <color name="notif_scope_lock">#52664D</color>
    <!-- 压在强调色实心底上的那一档颜色：浅色档石墨灰 #4A4A4A（深）→ 白；
         夜间档强调色提亮成 #D6D6D6（浅）→ 必须换成深墨，照抄白色就成了浅灰压白、几乎看不见。
         所以这一对刻意不写成同一个色。 -->
    <color name="notif_on_brand_ink">#FFFFFFFF</color>

    <!-- 常驻通知「温控 N」胶囊：低档中性、中档琥珀、高档红（语义色，仅这里用；夜间见 values-night） -->
    <color name="thermal_low_bg">#E7E7E7</color>
    <color name="thermal_low_fg">#4A4A4A</color>
    <color name="thermal_mid_bg">#FFEFD5</color>
    <color name="thermal_mid_fg">#8A5A00</color>
    <color name="thermal_high_bg">#FDE7E5</color>
    <color name="thermal_high_fg">#B3261E</color>

    <!-- 切换日志类型角标：同一套语义色在浅色/深色下各一档（夜间见 values-night） -->
    <color name="log_manual_bg">#E3F2FD</color>
    <color name="log_manual_fg">#0D47A1</color>
    <color name="log_auto_bg">#E8F5E9</color>
    <color name="log_auto_fg">#1B5E20</color>
    <color name="log_lib_bg">#F3E5F5</color>
    <color name="log_lib_fg">#4A148C</color>
    <color name="log_interval_bg">#FFF8E1</color>
    <color name="log_interval_fg">#8D6E00</color>
    <color name="log_mode_bg">#E0F7FA</color>
    <color name="log_mode_fg">#006064</color>
    <color name="log_pause_bg">#FFF3E0</color>
    <color name="log_pause_fg">#B53D00</color>
    <color name="log_resume_bg">#E0F2F1</color>
    <color name="log_resume_fg">#004D40</color>
    <color name="log_stop_bg">#FFEBEE</color>
    <color name="log_stop_fg">#B71C1C</color>
    <color name="log_setting_bg">#ECEFF1</color>
    <color name="log_setting_fg">#37474F</color>
</resources>
