<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 自适应图标背景色 -->
    <color name="ic_launcher_background">#1E88E5</color>

    <!-- 浅色 UI 配色：主色（与图标统一）、页面底、卡片底、两级文字、分隔线、危险操作红 -->
    <color name="brand">#1E88E5</color>
    <color name="page_bg">#F5F6F8</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="text_primary">#1A1C1E</color>
    <color name="text_secondary">#5F6368</color>
    <!-- 小组件配色：浅色 / 深色两档都在这一份里定死，**刻意不做 values-night 变体**。
         原因：深浅色切换时桌面会不会重画已摆着的小组件、重画时按哪一档配置解析，各家 ROM 不保证，
         光靠资源自动翻有停在旧档的风险。改成由代码按我们自己进程读到的 uiMode 挑一次
         （浅色挑无后缀那组、深色挑 _night 那组，见 WidgetConsoleProvider#isNight），
         与桌面配不配合无关。深色档对齐 App 夜间层级（card_bg #1E2024 / text_primary #E6E7E9）；
         格子与空态在深底上要"亮一档"（半透白）才看得出那是个键。
         对照：常驻通知里用 text_primary 是对的——通知整张卡跟随深浅色，且它的 RemoteViews 每次都由
         我们进程重算重发，不存在"停在旧档"这个问题。 -->
    <color name="widget_card">#F2FFFFFF</color>
    <color name="widget_card_night">#F21E2024</color>
    <color name="widget_cell">#0A000000</color>
    <color name="widget_cell_night">#1AFFFFFF</color>
    <color name="widget_empty">#24000000</color>
    <color name="widget_empty_night">#33FFFFFF</color>
    <color name="widget_ink">#1A1C1E</color>
    <color name="widget_ink_night">#E6E7E9</color>
    <color name="divider">#E8EAED</color>
    <color name="danger">#D93025</color>
    <!-- 通知封面「切换中」那层毛玻璃 veil：浅色档压一层半透白，深色档压一层半透墨（各自都让转圈看得清） -->
    <color name="notif_frost">#66FFFFFF</color>
    <!-- 常驻通知上那颗作用面角标的文字色：桌面用主色（上面已有 brand，含夜间变体），锁屏另给一色，
         两色在浅底深底上都够对比。刻意不复用 brand 的夜间值，免得两颗看起来是同一个意思。 -->
    <color name="notif_scope_lock">#7B52C9</color>
    <!-- 压在 brand 实心底上的那一档颜色（通知那颗开关「已钉住」的圆钮用它）：浅色档 brand 是 #1E88E5
         （深）→ 白；夜间档 brand 提亮成 #90CAF9（浅）→ 必须换成深墨，照抄白色就成了浅蓝压白、几乎看不见。
         所以这一对刻意不写成同一个色。 -->
    <color name="notif_on_brand_ink">#FFFFFFFF</color>
    <!-- 范围槽位卡片的初值（= 色相 30、浓淡 0 算出来的纸白）：实际显示色由 SlotTheme
         按用户挑的色相 + 浓淡现算，这里只顶住绑定前那一帧，免得闪一下旧底色。 -->
    <color name="slot_bg">#F6F5F3</color>
    <color name="slot_stroke">#E1DBD6</color>
    <!-- 底色偏暗时三行文字翻白的两档（亮度判定见 SlotTheme.dark） -->
    <color name="slot_text_on_dark">#FFFFFF</color>
    <color name="slot_text_dim_on_dark">#D6DADE</color>
</resources>