<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 自适应图标背景色 -->
    <color name="ic_launcher_background">#1E88E5</color>

    <!-- 浅色 UI 配色：主色（与图标统一）、页面底、卡片底、两级文字、分隔线、危险操作红 -->
    <color name="brand">#1E88E5</color>
    <color name="page_bg">#F5F6F8</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="text_primary">#1A1C1E</color>
    <color name="text_secondary">#5F6368</color>
    <color name="divider">#E8EAED</color>
    <color name="danger">#D93025</color>
    <!-- 范围槽位卡片的四套配色（聚合设置里四个色块当场挑，全局一份、两面同色）。
         默认 = A 纸白；item_slot.xml 里的初值也用它，绑定时再由 SlotTheme 覆盖。
         刻意与库行不同样子：靠底色 + 描边拉开层级，色彩让给左边那张缩略图。 -->
    <color name="slot_bg">#F7F4EF</color>
    <color name="slot_stroke">#E6DFD5</color>
    <!-- A 纸白：暖中性 -->
    <color name="slot_a_bg">#F7F4EF</color>
    <color name="slot_a_stroke">#E6DFD5</color>
    <!-- B 灰紫：还是冷的，但不跟品牌蓝抢同一片色相 -->
    <color name="slot_b_bg">#F2F0F6</color>
    <color name="slot_b_stroke">#DFDCE8</color>
    <!-- C 灰绿：保留一点彩色感 -->
    <color name="slot_c_bg">#EDF3F0</color>
    <color name="slot_c_stroke">#D2E2DA</color>
    <!-- D 墨：深色控制条，三行文字要跟着翻白，缩略图占位底色也压暗 -->
    <color name="slot_d_bg">#2B2F33</color>
    <color name="slot_d_stroke">#2B2F33</color>
    <color name="slot_d_thumb_bg">#3A4046</color>
    <color name="slot_d_text">#FFFFFF</color>
    <color name="slot_d_text_dim">#B8BDC2</color>
</resources>