<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material3 主题（DayNight：跟随系统深浅色，配色见 values/ 与 values-night/colors.xml）。
         边到边（全面屏/刘海屏）适配：状态栏与页面底色一致实现无缝；导航栏透明 + 系统栏图标明暗
         跟随深浅色（@bool/light_system_bars）。
         注意：Android 15（targetSdk 35）起系统忽略状态栏/导航栏颜色并强制边到边，
         此时透出 windowBackground，行为仍一致；导航栏对比度遮罩在 InsetsHelper 里按 API 29+ 代码关闭。 -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>

    <!-- 壁纸列表缩略图的圆角外形 -->
    <style name="RoundedThumb">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- 两列正方形网格里壁纸格的圆角外形 -->
    <style name="RoundedGrid">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
